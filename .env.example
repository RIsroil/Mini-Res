# ===========================================
# QR Menu Platform - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment
# For production: change ALL passwords and secrets!

# Database (PostgreSQL with PostGIS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=qrmenu
DB_USER=admin
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Security (MUST CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# MinIO Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET_NAME=qrmenu-images

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Server
PORT=8080
